{
    "name": "wsmallnews/member",
    "description": "Wsmallnews system member modules",
    "keywords": [
        "Wsmallnews",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "member"
    ],
    "homepage": "https://github.com/wsmallnews/member",
    "support": {
        "issues": "https://github.com/wsmallnews/member/issues",
        "source": "https://github.com/wsmallnews/member"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "smallnews",
            "email": "1371606921@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Wsmallnews\\Member\\": "src/",
            "Wsmallnews\\Member\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "./src/Helpers/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Wsmallnews\\Member\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wsmallnews\\Member\\MemberServiceProvider"
            ],
            "aliases": {
                "Member": "Wsmallnews\\Member\\Facades\\Member"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}